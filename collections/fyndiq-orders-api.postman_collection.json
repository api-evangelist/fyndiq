  "info": {
    "_postman_id": "49df6388-aec5-45a6-a358-39e686c7779e",
    "name": "Fyndiq Merchant Articles Orders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Fyndiq Merchant API enables merchants to upload and manage products (articles) and to retrieve and fulfil orders on the Fyndiq marketplace, Sweden's largest marketplace for bargains. The API is REST-oriented, uses JSON request and response bodies, and is protected with HTTP Basic Authentication (Base64-encoded `merchantID:token`). A self-contained sandbox environment mirrors production for integration testing.\n\nContact Support:\n Name: Fyndiq Merchant Help Center",
      "type": "text/plain"
    }
  }
